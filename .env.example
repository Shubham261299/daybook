# Folder containing your local Git repositories; use forward slashes on Windows.
REPOS_ROOT=./repos
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
DB_PATH=./data/activity.db
DIFF_STORAGE_PATH=./data/diffs
DIFF_EXCLUSIONS_PATH=./config/diff_exclusions.yaml
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8510
# Optional local dashboard password. Set your own value; never commit a real secret.
DASHBOARD_PASSWORD=
TZ=UTC
QUIET_THRESHOLD_DAYS=7
# Collection is disabled natively by default; Docker Compose defaults to 3600 seconds.
# COLLECT_INTERVAL_SECONDS=0
EOD_HOUR=-1
